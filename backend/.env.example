# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)
PORT=4000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aimslog
JWT_SECRET=เปลี่ยนเป็นข้อความสุ่มยาวๆ
SESSION_HOURS=8
# โดเมน Frontend (คั่นด้วย , ได้หลายอัน) — ใช้เมื่อเรียก API ข้ามโดเมนตรงๆ
FRONTEND_ORIGIN=http://localhost:5173
# NODE_ENV=production   (ตั้งบน Render เพื่อให้ cookie เป็น Secure)
