{
  "info": {
    "name": "AIMSlog API",
    "description": "ระบบจัดการและตรวจนับครุภัณฑ์ สาขาวิทยาการคอมพิวเตอร์ มธ.\n\n1) ตั้งค่า Variables: baseUrl, username, password\n2) รัน Auth → Login ก่อน (เก็บ JWT ใน {{token}} อัตโนมัติ)\n3) รันทั้ง collection ได้ — โฟลเดอร์สุดท้าย \"⚠️ อันตราย\" ให้ยกเลิกการเลือกก่อนรันกับข้อมูลจริง\n\nรายละเอียด: docs/API.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://aimslog-api.onrender.com/api"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "meId",
      "value": ""
    },
    {
      "key": "assetId",
      "value": ""
    },
    {
      "key": "inspectionId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "room",
      "value": "บร.2 ชั้น 1 ห้อง 107"
    }
  ],
  "item": [
    {
      "name": "1. ระบบ",
      "description": "",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.test(\"database connected\", () => pm.expect(pm.response.json().database).to.eql(\"connected\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Render แบบฟรีอาจใช้เวลา 30–60 วินาทีตอนตื่น"
          }
        }
      ]
    },
    {
      "name": "2. Auth",
      "description": "",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "const t = pm.cookies.get(\"token\"); if (t) pm.collectionVariables.set(\"token\", t);",
                  "if (pm.response.code < 300) { const j = pm.response.json(); if (j.user && j.user.id) pm.collectionVariables.set(\"meId\", j.user && j.user.id); }",
                  "pm.test(\"ได้ JWT\", () => pm.expect(pm.collectionVariables.get(\"token\")).to.not.be.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "เก็บ JWT จาก cookie \"token\" ไว้ใน {{token}} ให้คำขออื่นใช้แบบ Bearer"
          }
        },
        {
          "name": "Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.test(\"มี user\", () => pm.expect(pm.response.json().user).to.have.property(\"role\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Update profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"position\": \"เจ้าหน้าที่พัสดุ\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "profile"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Change password (ตัวอย่าง — คาด 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.expect(pm.response.code).to.be.oneOf([400]));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"wrong\",\n  \"newPassword\": \"short\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "password"
              ]
            },
            "description": "ตัวอย่าง validation: รหัสใหม่สั้นกว่า 8 ตัว → 400 (ไม่เปลี่ยนรหัสจริง)"
          }
        },
        {
          "name": "Without token (คาด 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200 / 401\", () => pm.expect(pm.response.code).to.be.oneOf([200, 401]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Postman อาจส่ง cookie ที่เก็บไว้ไปด้วย ถ้าล้าง cookie แล้วจะได้ 401"
          }
        }
      ]
    },
